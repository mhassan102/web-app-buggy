{
  "app_boot_cmd": [
    "{python}",
    "{repo}/app.py",
    "--port",
    "{port}"
  ],
  "install_cmd": [
    "{python}",
    "-m",
    "pip",
    "install",
    "--no-cache-dir",
    "-r",
    "{repo}/requirements.txt"
  ],
  "ready_url": "http://127.0.0.1:{port}/health",
  "timeout": 60,
  "targets": [
    {
      "route": "/items",
      "exploit_class": "boolean_sqli",
      "file": "items.py",
      "injection_param": "q",
      "injection_location": "query"
    },
    {
      "route": "/download",
      "exploit_class": "lfi",
      "file": "download.py",
      "injection_param": "file",
      "injection_location": "query"
    },
    {
      "route": "/go",
      "exploit_class": "external_redirect",
      "file": "redirects.py",
      "injection_param": "next",
      "injection_location": "query"
    },
    {
      "route": "/notes/1",
      "exploit_class": "cross_principal_access",
      "file": "notes.py",
      "injection_param": "Authorization",
      "injection_location": "header",
      "authorization": {
        "victim": {
          "headers": {
            "Authorization": "Bearer token-alice"
          }
        },
        "attacker": {
          "headers": {
            "Authorization": "Bearer token-bob"
          }
        },
        "marker": "MARKER-alice-note-7f3c91d2",
        "environment": {
          "identity": "seeded-notes"
        }
      }
    },
    {
      "route": "/search",
      "exploit_class": "reflected_xss",
      "file": "search.py",
      "injection_param": "q",
      "injection_location": "query"
    },
    {
      "route": "/notes",
      "exploit_class": "hardcoded_credential",
      "file": "notes.py",
      "injection_param": "Authorization",
      "injection_location": "header",
      "secret": {
        "header": "Authorization",
        "value": "Bearer token-alice",
        "decoy": "Bearer token-not-in-source"
      }
    },
    {
      "route": "/export",
      "exploit_class": "hardcoded_credential",
      "file": "export_key.py",
      "injection_param": "X-Api-Key",
      "injection_location": "header",
      "secret": {
        "header": "X-Api-Key",
        "value": "sk-buggy-7f3c91d2e88a0c4",
        "decoy": "Bearer decoy-not-the-export-key"
      }
    },
    {
      "route": "/greet",
      "exploit_class": "ssti",
      "file": "greet.py",
      "injection_param": "name",
      "injection_location": "query"
    },
    {
      "route": "/preview",
      "exploit_class": "ssrf",
      "file": "fetch.py",
      "injection_param": "url",
      "injection_location": "query"
    },
    {
      "route": "/calc",
      "exploit_class": "evaluated_expr",
      "file": "evaluate.py",
      "injection_param": "expr",
      "injection_location": "query"
    },
    {
      "route": "/exec",
      "exploit_class": "executed_code",
      "file": "execute.py",
      "injection_param": "code",
      "injection_location": "query"
    },
    {
      "route": "/shell",
      "exploit_class": "shell_stdout",
      "file": "shell_cmd.py",
      "injection_param": "name",
      "injection_location": "query"
    },
    {
      "route": "/ping",
      "exploit_class": "shell_status",
      "file": "system_cmd.py",
      "injection_param": "host",
      "injection_location": "query"
    },
    {
      "route": "/convert",
      "exploit_class": "command_output",
      "file": "commands.py",
      "injection_param": "path",
      "injection_location": "query",
      "observation": "output"
    },
    {
      "route": "/shell",
      "exploit_class": "command_output",
      "file": "shell_cmd.py",
      "injection_param": "name",
      "injection_location": "query",
      "observation": "output"
    },
    {
      "route": "/ping",
      "exploit_class": "command_output",
      "file": "system_cmd.py",
      "injection_param": "host",
      "injection_location": "query",
      "observation": "status"
    },
    {
      "route": "/ldap",
      "exploit_class": "ldap_filter",
      "file": "directory.py",
      "injection_param": "user",
      "injection_location": "query"
    },
    {
      "route": "/xpath",
      "exploit_class": "xpath_concat",
      "file": "xpath_query.py",
      "injection_param": "name",
      "injection_location": "query"
    },
    {
      "route": "/assist",
      "exploit_class": "prompt_override",
      "file": "assistant.py",
      "injection_param": "message",
      "injection_location": "query"
    },
    {
      "route": "/checkout",
      "exploit_class": "client_price",
      "file": "checkout.py",
      "injection_param": "price",
      "injection_location": "query"
    },
    {
      "route": "/transfer",
      "exploit_class": "fail_open",
      "file": "transfer.py",
      "injection_param": "amount",
      "injection_location": "query"
    },
    {
      "route": "/register",
      "exploit_class": "md5_password",
      "file": "passwords.py",
      "injection_param": "password",
      "injection_location": "query"
    },
    {
      "route": "/reset",
      "exploit_class": "guessable_token",
      "file": "tokens.py",
      "injection_param": "user",
      "injection_location": "query"
    }
  ]
}
